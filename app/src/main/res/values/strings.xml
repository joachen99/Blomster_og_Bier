    <!-- For PlantDatabase -->
    <string name="plant_lavendel_name">Lavendel</string>
    <string name="plant_lavendel_latin_name">Lavandula angustifolia</string>
    <string name="plant_lavendel_description">Klassisk hageplante med duftende lilla blomsterstander. Trives i varm, solrik og godt drenert jord. En av de viktigste plantene for bier og humler.</string>
    <string name="plant_lavendel_soil_type">Godt drenert, gjerne kalkholdig</string>
    <string name="plant_lavendel_tips">Klipp tilbake etter blomstring for å holde planten kompakt. Unngå vannlogging – det er den vanligste årsaken til at lavendel dør i norske hager.</string>

    <string name="plant_kattemynte_name">Kattemynte</string>
    <string name="plant_kattemynte_latin_name">Nepeta x faassenii</string>
    <string name="plant_kattemynte_description">Lettstelt staude med blågrå blader og rikelig med blålilla blomster. En av de mest pollinatorvennlige plantene du kan ha i hagen. Tåler tørke og varme godt.</string>
    <string name="plant_kattemynte_soil_type">Godt drenert, alle typer</string>
    <string name="plant_kattemynte_tips">Klipp ned etter første blomstring i juli – da blomstrer den gjerne igjen i august og september.</string>

    <string name="plant_sverdlilje_name">Sverdlilje</string>
    <string name="plant_sverdlilje_latin_name">Iris sibirica</string>
    <string name="plant_sverdlilje_description">Elegant staude med slanke blader og vakre blålilla blomster. Trives i fuktig jord og langs vannkanter. Besøkes av humler og bier.</string>
    <string name="plant_sverdlilje_soil_type">Fuktig til normal</string>
    <string name="plant_sverdlilje_tips">Del opp store tuster hvert 3–4 år for å opprettholde god blomstring.</string>

    <string name="plant_mynte_name">Mynte</string>
    <string name="plant_mynte_latin_name">Mentha spicata</string>
    <string name="plant_mynte_description">Aromatisk urt som sprer seg kraftig og blomstrer med små lilla blomsterkroner. Svært populær hos humler og bier. Tåler fuktig jord godt.</string>
    <string name="plant_mynte_soil_type">Fuktig til normal, næringsrik</string>
    <string name="plant_mynte_tips">Plant i en nedgravd bøtte uten bunn for å begrense spredningen. Blomstrer best når du ikke høster for hardt.</string>

    <string name="plant_daglilje_name">Daglilje</string>
    <string name="plant_daglilje_latin_name">Hemerocallis</string>
    <string name="plant_daglilje_description">Robust og svært lettstelt staude med store blomster i gult, oransje og rødt. Tåler nesten alt – tørke, oversvømmelse og forsømmelse. Besøkes av humler.</string>
    <string name="plant_daglilje_soil_type">Alle typer</string>
    <string name="plant_daglilje_tips">En av de mest robuste staudene du kan ha i hagen. Blomstene varer bare én dag, men planten produserer mange knopper.</string>

    <string name="plant_blasvingel_name">Blåsvingel</string>
    <string name="plant_blasvingel_latin_name">Festuca glauca</string>
    <string name="plant_blasvingel_description">Kompakt prydgress med stålblå blader. Dype røtter binder jord og hjelper mot erosjon ved kraftig nedbør. Tåler både tørke og kortvarig oversvømmelse.</string>
    <string name="plant_blasvingel_soil_type">Godt drenert til normal</string>
    <string name="plant_blasvingel_tips">Planter med dype røtter er viktige i skråninger og langs kanter der kraftig regn kan erodere jord.</string>

    <string name="plant_oregano_name">Oregano</string>
    <string name="plant_oregano_latin_name">Origanum vulgare</string>
    <string name="plant_oregano_description">Hardfør urt med små rosa-lilla blomster som er ekstremt populære hos bier og humler. Blomstrer sent på sesongen og er en av de beste bieplantene du kan ha.</string>
    <string name="plant_oregano_soil_type">Godt drenert, varm</string>
    <string name="plant_oregano_tips">La noen planter stå og blomstre uten å høste – det gir mat til bier sent i sesongen når lite annet blomstrer.</string>

    <string name="plant_ryllik_name">Ryllik</string>
    <string name="plant_ryllik_latin_name">Achillea millefolium</string>
    <string name="plant_ryllik_description">Hardfør og lettstelt staude med flate blomsterskjermer i hvitt, rosa eller gult. Tåler vanlige norske sommere godt og er svært populær hos bier og sommerfugler.</string>
    <string name="plant_ryllik_soil_type">Normal til godt drenert</string>
    <string name="plant_ryllik_tips">Ryllik tåler både tørre og normale perioder godt, og passer fint i naturpregede bed og blomsterenger.</string>

    <string name="plant_akeleie_name">Akeleie</string>
    <string name="plant_akeleie_latin_name">Aquilegia vulgaris</string>
    <string name="plant_akeleie_description">Elegant staude med karakteristiske blomster i lilla, blått, rosa eller hvitt. En viktig tidlig matkilde for humler og bier i hagen.</string>
    <string name="plant_akeleie_soil_type">Normal, gjerne moldrik</string>
    <string name="plant_akeleie_tips">Akeleie frøsår seg lett og dukker ofte opp nye steder i hagen fra år til år.</string>

    <string name="plant_stjerneskjerm_name">Stjerneskjerm</string>
    <string name="plant_stjerneskjerm_latin_name">Astrantia major</string>
    <string name="plant_stjerneskjerm_description">Vakre stjerneformede blomster i hvitt eller rosa som blomstrer lenge gjennom sommeren. Trives godt i vanlig hagejord og tiltrekker bier og andre pollinatorer.</string>
    <string name="plant_stjerneskjerm_soil_type">Normal til lett fuktig</string>
    <string name="plant_stjerneskjerm_tips">Fjern visne blomster underveis for å forlenge blomstringen utover sensommeren.</string>

    <!-- For AboutAppScreen -->
    <string name="about_app_intro">Denne appen er laget for deg som er interessert i planter, bier og hvordan klimaet påvirker hagen din.</string>
    <string name="how_it_works_title">Slik fungerer appen</string>
    <string name="how_it_works_text">Trykk på et sted på kartet for å velge plasseringen til hagen din. Trykk så på &quot;Last inn data for ...&quot;. Appen henter så inn klimadata og gir deg skreddersydde anbefalinger for området du valgte.</string>
    <string name="what_you_get_title">Hva du får</string>
    <string name="bullet_plants">• Du får forslag til planter som trives i klimaet der du bor, inkludert bie-vennlige alternativer som er nyttige for pollinerende insekter.</string>
    <string name="bullet_actions">• Appen gir også råd om tiltak du kan gjøre for å beskytte hagen mot styrtregn, og tips til hvordan du kan tilrettelegge hagen for bier.</string>
    <string name="bullet_climate">• I tillegg kan du se klimastatistikk for det valgte området, slik at du får en bedre forståelse av klima der hagen er plassert.</string>
